#!/bin/bash

# Проверка аргумента
if [ -z "$1" ]; then
  echo "Использование: $0 <catalog_name>"
  exit 1
fi

CATALOG_NAME="$1"
CONFIG_PATH="$HOME/.config/$CATALOG_NAME"
DOTFILE_DIR="$HOME/dotfile/$CATALOG_NAME"
TARGET_PATH="$DOTFILE_DIR/.config/$CATALOG_NAME"
DATE_SUFFIX=$(date +"%d_%m_%Y")

# Проверка, существует ли исходный каталог
if [ ! -d "$CONFIG_PATH" ]; then
  echo "Каталог $CONFIG_PATH не существует."
  exit 1
fi

# Бэкап, если каталог в dotfile уже существует
if [ -d "$DOTFILE_DIR" ]; then
  BACKUP_DIR="${DOTFILE_DIR}_bak_${DATE_SUFFIX}"
  echo "Каталог $DOTFILE_DIR уже существует. Переименовываем в $BACKUP_DIR"
  mv "$DOTFILE_DIR" "$BACKUP_DIR"
fi

# Создание целевой директории
mkdir -p "$(dirname "$TARGET_PATH")"

# Перемещение каталога
mv "$CONFIG_PATH" "$TARGET_PATH"

# Переход в директорию dotfiles (на всякий случай)
cd "$HOME/dotfile" || exit 1

# Запуск stow
stow "$CATALOG_NAME"

echo "Каталог успешно перемещён и подключён через stow."

