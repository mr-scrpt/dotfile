#!/usr/bin/env bash
# Local LLM server (llama.cpp) for Hermes. Quality + big context on RTX 5080 16 GB.
# Measured (Sep 2026): ncffn=46 no-vision 16.5 tok/s; ncffn=52 + vision 15.0 tok/s @0K, ctx 96K, VRAM 15.6 GB.
# Usage: llama-local [extra llama-server args]
set -euo pipefail

LLAMA_DIR="$HOME/.local/opt/llama.cpp/current"
MODEL="${LLAMA_MODEL:-$HOME/models/Qwen3.8-27B-UD-Q4_K_XL.gguf}"
CTX="${LLAMA_CTX:-98304}"
# Dense FFN weights of the first N (of 64) layers live in system RAM; attention + KV stay on GPU.
# Lower N = faster but more VRAM (44 is the OOM edge with a desktop running). Raise N to free VRAM.
NCFFN="${LLAMA_NCFFN:-52}"
# Vision projector (mmproj) costs ~0.9 GB VRAM -> needs NCFFN>=52 (~1.5 tok/s slower). Set LLAMA_MMPROJ= to disable.
MMPROJ="${LLAMA_MMPROJ:-$HOME/models/Qwen3.8-27B-mmproj-F16.gguf}"

export LD_LIBRARY_PATH="$LLAMA_DIR${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
export GGML_CUDA_DISABLE_GRAPHS=1   # CUDA graphs + CPU offload + MTP => crashes

MM=()
[[ -n "$MMPROJ" && -f "$MMPROJ" ]] && MM=(--mmproj "$MMPROJ")

exec "$LLAMA_DIR/llama-server" \
  -m "$MODEL" "${MM[@]}" \
  --alias qwen3.8-27b \
  --host 127.0.0.1 --port 8080 \
  -ngl 99 -ncffn "$NCFFN" \
  -c "$CTX" -fa on -ctk q8_0 -ctv q5_0 \
  --fit off -np 1 --load-mode none -t 8 \
  -b 1024 -ub 512 \
  --jinja --reasoning-format deepseek --reasoning-budget 8192 \
  --spec-type draft-mtp --spec-draft-n-max 2 --spec-draft-p-min 0.0 \
  --temp 0.7 --top-p 0.8 --top-k 20 --min-p 0.0 --presence-penalty 1.5 \
  "$@"
