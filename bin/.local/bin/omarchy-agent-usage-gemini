#!/usr/bin/env python3
import subprocess
import json
import re
import os
import tempfile
from datetime import datetime, timezone

def parse_usage():
    try:
        result = subprocess.run(["agy", "-p", "/usage"], capture_output=True, text=True, timeout=30)
        output = result.stdout
    except Exception as e:
        return {"error": str(e)}

    limits = []
    for line in output.split('\n'):
        if "Limit Remaining" in line:
            parts = [p.strip() for p in line.split('\t') if p.strip()]
            if len(parts) >= 4:
                model_group = parts[0]
                limit_type = parts[1].replace(" Limit Remaining", "")
                remaining_pct_str = parts[2].replace("%", "")
                resets_at = parts[3]
                
                try:
                    remaining_pct = float(remaining_pct_str)
                    used_percent = (100.0 - remaining_pct) / 100.0
                    
                    label = f"{limit_type} ({model_group})"
                    if "Five Hour" in limit_type:
                        label = f"Session (5-hour) [{model_group}]"
                    elif "Weekly" in limit_type:
                        label = f"Weekly (7-day) [{model_group}]"
                        
                    limits.append({
                        "label": label,
                        "percent": used_percent,
                        "resetsAt": resets_at
                    })
                except Exception:
                    pass
    
    return limits

def get_stats():
    db_path = os.path.expanduser("~/.gemini/antigravity-cli/conversation_summaries.db")
    today_sessions, total_sessions, today_prompts, total_prompts = 0, 0, 0, 0
    
    if os.path.exists(db_path):
        try:
            q1 = subprocess.run(["sqlite3", db_path, "SELECT count(*) FROM conversation_summaries WHERE date(last_user_input_time) = date('now');"], capture_output=True, text=True)
            if q1.stdout.strip().isdigit(): today_sessions = int(q1.stdout.strip())
            
            q2 = subprocess.run(["sqlite3", db_path, "SELECT count(*) FROM conversation_summaries;"], capture_output=True, text=True)
            if q2.stdout.strip().isdigit(): total_sessions = int(q2.stdout.strip())
            
            q3 = subprocess.run(["sqlite3", db_path, "SELECT sum(step_count) FROM conversation_summaries WHERE date(last_user_input_time) = date('now');"], capture_output=True, text=True)
            if q3.stdout.strip().isdigit(): today_prompts = int(q3.stdout.strip())
            
            q4 = subprocess.run(["sqlite3", db_path, "SELECT sum(step_count) FROM conversation_summaries;"], capture_output=True, text=True)
            if q4.stdout.strip().isdigit(): total_prompts = int(q4.stdout.strip())
        except Exception:
            pass
            
    return today_sessions, total_sessions, today_prompts, total_prompts

def main():
    usage_dir = os.path.expanduser("~/.local/state/omarchy/agents/usage")
    target_file = os.path.join(usage_dir, "gemini.json")
    
    # Load old data as fallback
    old_data = {}
    if os.path.exists(target_file):
        try:
            with open(target_file, "r") as f:
                old_data = json.load(f)
        except Exception:
            pass

    limits = parse_usage()
    if isinstance(limits, dict) and "error" in limits:
        limits = []

    # If parsing failed or timed out, reuse old limits
    if not limits and old_data.get("limits"):
        limits = old_data["limits"]

    today_sessions, total_sessions, today_prompts, total_prompts = get_stats()

    record = {
        "schemaVersion": 1,
        "id": "gemini",
        "name": "Antigravity",
        "updatedAt": datetime.now(timezone.utc).isoformat(),
        "ready": True,
        "hasLocalStats": True,
        "tierLabel": "Pro",
        "usageStatusText": "" if limits else "Failed to fetch limits",
        "authHelpText": "",
        "limits": limits,
        "todayPrompts": today_prompts,
        "todaySessions": today_sessions,
        "todayTotalTokens": 0,
        "todayTokensByModel": {},
        "recentDays": [],
        "totalPrompts": total_prompts,
        "totalSessions": total_sessions,
        "activeDays": 1,
        "activeDates": [datetime.now(timezone.utc).strftime("%Y-%m-%d")],
        "modelUsage": {}
    }
    
    os.makedirs(usage_dir, exist_ok=True)
    
    # Atomic write to avoid breaking the UI file watcher
    fd, temp_path = tempfile.mkstemp(dir=usage_dir, prefix=".gemini.", suffix=".tmp")
    with os.fdopen(fd, "w") as f:
        json.dump(record, f, separators=(",", ":"))
    os.replace(temp_path, target_file)

if __name__ == "__main__":
    main()
