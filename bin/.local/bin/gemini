#!/bin/bash
args=()
while [[ $# -gt 0 ]]; do
    case "$1" in
        --yolo)
            args+=("--dangerously-skip-permissions")
            shift
            ;;
        --prompt-interactive)
            # Omarchy passes --prompt-interactive followed by the prompt.
            # For agy, the equivalent is -i or --prompt-interactive
            args+=("--prompt-interactive")
            shift
            ;;
        *)
            args+=("$1")
            shift
            ;;
    esac
done
exec agy "${args[@]}"
