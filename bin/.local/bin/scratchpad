#!/usr/bin/env bash
# Скретчпад: плавающее окно foot с nvim на сегодняшнем файле (или последнем открытом).

set -euo pipefail

# 1. Проверяем тогл окна
PID=$(hyprctl clients -j | jq -r '.[] | select(.class == "scratchpad") | .pid' | head -1)

if [[ -n "$PID" ]]; then
    # Если процесс найден — закрываем его (тогл).
    # Отправляем SIGTERM для мягкого закрытия.
    kill -TERM "$PID"
    exit 0
fi

# 2. Ищем или создаем файл для открытия
TODAY_DIR="$HOME/Notes/scratch/$(date +%F)"
mkdir -p "$TODAY_DIR"

STATE_FILE="$HOME/.local/state/scratchpad_last_opened"
mkdir -p "$(dirname "$STATE_FILE")"

FILE_TO_OPEN=""

# Если state-файл существует, читаем его
if [[ -f "$STATE_FILE" ]]; then
    LAST_OPENED=$(cat "$STATE_FILE")
    # Проверяем, существует ли этот файл и находится ли он в папке сегодняшнего дня
    if [[ -f "$LAST_OPENED" && "$(dirname "$LAST_OPENED")" == "$TODAY_DIR" ]]; then
        FILE_TO_OPEN="$LAST_OPENED"
    fi
fi

# Если файл из state-файла не подошел, ищем последний измененный в папке сегодня
if [[ -z "$FILE_TO_OPEN" ]]; then
    LAST_MODIFIED=$(find "$TODAY_DIR" -maxdepth 1 -name "*.md" -type f -printf '%T@ %p\n' | sort -n | tail -1 | cut -d' ' -f2-)
    if [[ -n "$LAST_MODIFIED" ]]; then
        FILE_TO_OPEN="$LAST_MODIFIED"
    fi
fi

# Если файлов сегодня еще нет, создаем новый (untitled)
if [[ -z "$FILE_TO_OPEN" ]]; then
    FILE_TO_OPEN="$TODAY_DIR/untitled-$(date +%s).md"
    # Создаем пустой файл, чтобы nvim знал, что он существует
    touch "$FILE_TO_OPEN"
fi

# 3. Открываем
exec foot --app-id=scratchpad -e nvim "$FILE_TO_OPEN"
