#!/bin/bash

# Конфигурация
DOTFILES_DIR="$HOME/Hellkitchen/dotfile"
TARGET_DIR="$HOME"
BACKUP_DIR="$DOTFILES_DIR/_backup"
EXCLUDED_DIRS=("_backup" ".git")

# Цвета для вывода
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Функция для вывода цветных сообщений
log_info() { echo -e "${BLUE}ℹ${NC} $1"; }
log_success() { echo -e "${GREEN}✓${NC} $1"; }
log_warning() { echo -e "${YELLOW}⚠${NC} $1"; }
log_error() { echo -e "${RED}✗${NC} $1"; }

# Проверка зависимостей
check_dependencies() {
    local missing_deps=()
    
    if ! command -v stow &> /dev/null; then
        missing_deps+=("stow")
    fi
    
    if ! command -v gum &> /dev/null; then
        missing_deps+=("gum")
    fi
    
    if [ ${#missing_deps[@]} -ne 0 ]; then
        log_error "Отсутствуют необходимые утилиты: ${missing_deps[*]}"
        echo "Установите их с помощью: sudo pacman -S ${missing_deps[*]}"
        exit 1
    fi
}

# Проверка директории dotfiles
check_dotfiles_dir() {
    if [ ! -d "$DOTFILES_DIR" ]; then
        log_error "Директория $DOTFILES_DIR не найдена"
        exit 1
    fi
}

# Получить список доступных пакетов
get_available_packages() {
    local packages=()
    
    for dir in "$DOTFILES_DIR"/*/; do
        [ -d "$dir" ] || continue
        local package=$(basename "$dir")
        
        # Исключаем служебные директории
        local skip=false
        for excluded in "${EXCLUDED_DIRS[@]}"; do
            if [ "$package" = "$excluded" ]; then
                skip=true
                break
            fi
        done
        
        [ "$skip" = false ] && packages+=("$package")
    done
    
    echo "${packages[@]}"
}

# Найти целевую директорию пакета (ту, что соответствует имени пакета)
find_target_paths() {
    local package="$1"
    local package_dir="$DOTFILES_DIR/$package"
    local targets=()
    
    # Ищем директорию с именем пакета внутри структуры (но не саму корневую)
    while IFS= read -r -d '' item; do
        # Пропускаем корневую директорию пакета
        [ "$item" = "$package_dir" ] && continue
        
        local basename=$(basename "$item")
        if [ "$basename" = "$package" ]; then
            local rel_path="${item#$package_dir/}"
            local target_path="$TARGET_DIR/$rel_path"
            targets+=("$target_path")
        fi
    done < <(find "$package_dir" -mindepth 1 -type d -name "$package" -print0 2>/dev/null)
    
    # Если не нашли директорию с именем пакета, берём всё содержимое первого уровня
    if [ ${#targets[@]} -eq 0 ]; then
        while IFS= read -r -d '' item; do
            local rel_path="${item#$package_dir/}"
            local target_path="$TARGET_DIR/$rel_path"
            targets+=("$target_path")
        done < <(find "$package_dir" -mindepth 1 -maxdepth 1 -print0 2>/dev/null)
    fi
    
    printf '%s\n' "${targets[@]}"
}

# Проверить конфликты для пакета
check_conflicts() {
    local package="$1"
    local conflicts=()
    
    while IFS= read -r target; do
        if [ -e "$target" ] && [ ! -L "$target" ]; then
            conflicts+=("$target")
        fi
    done < <(find_target_paths "$package")
    
    printf '%s\n' "${conflicts[@]}"
}

# Создать бэкап
create_backup() {
    local package="$1"
    local timestamp=$(date +"%d_%m_%y_%H_%M_%S")
    local backup_path="$BACKUP_DIR/${package}_${timestamp}"
    
    mkdir -p "$backup_path"
    
    local conflicts=()
    while IFS= read -r line; do
        [ -n "$line" ] && conflicts+=("$line")
    done < <(check_conflicts "$package")
    
    if [ ${#conflicts[@]} -eq 0 ]; then
        return 0
    fi
    
    log_info "Создание бэкапа для $package..."
    
    for conflict in "${conflicts[@]}"; do
        local rel_path="${conflict#$TARGET_DIR/}"
        local backup_file="$backup_path/$rel_path"
        local backup_file_dir=$(dirname "$backup_file")
        
        mkdir -p "$backup_file_dir"
        
        if mv "$conflict" "$backup_file" 2>/dev/null; then
            log_success "  Сохранено: $rel_path"
        else
            log_error "  Не удалось сохранить: $rel_path"
            return 1
        fi
    done
    
    log_success "Бэкап создан: $backup_path"
    return 0
}

# Установить пакет через stow
install_package() {
    local package="$1"
    
    log_info "Установка $package..."
    
    local stow_output=$(stow -v -d "$DOTFILES_DIR" -t "$TARGET_DIR" "$package" 2>&1)
    local stow_exit=$?
    
    if [ $stow_exit -eq 0 ]; then
        log_success "$package успешно установлен"
        return 0
    else
        log_error "Ошибка при установке $package"
        echo "$stow_output" | sed 's/^/  /'
        return 1
    fi
}

# Показать предпросмотр изменений
preview_changes() {
    local package="$1"
    
    echo ""
    echo "═══════════════════════════════════════════════"
    echo "Предпросмотр для пакета: $package"
    echo "═══════════════════════════════════════════════"
    
    local has_conflicts=false
    while IFS= read -r target; do
        local rel_path="${target#$TARGET_DIR/}"
        
        if [ -e "$target" ] && [ ! -L "$target" ]; then
            echo -e "${YELLOW}[КОНФЛИКТ]${NC} $rel_path (будет создан бэкап)"
            has_conflicts=true
        elif [ -L "$target" ]; then
            echo -e "${BLUE}[СИМЛИНК]${NC}  $rel_path (уже установлен)"
        else
            echo -e "${GREEN}[НОВЫЙ]${NC}    $rel_path"
        fi
    done < <(find_target_paths "$package")
    
    echo "═══════════════════════════════════════════════"
    echo ""
    
    return $([ "$has_conflicts" = true ] && echo 1 || echo 0)
}

# Главная функция
main() {
    echo ""
    gum style --border double --padding "1 2" --border-foreground 212 "🔧 Менеджер Dotfiles"
    echo ""
    
    check_dependencies
    check_dotfiles_dir
    
    # Получаем список пакетов
    local packages=($(get_available_packages))
    
    if [ ${#packages[@]} -eq 0 ]; then
        log_error "Не найдено ни одного пакета в $DOTFILES_DIR"
        exit 1
    fi
    
    log_info "Найдено пакетов: ${#packages[@]}"
    echo ""
    
    # Выбор пакетов через gum
    local selected_packages=$(printf '%s\n' "${packages[@]}" | \
        gum choose --no-limit --header "Выберите пакеты для установки (Space - выбрать, Enter - подтвердить):")
    
    if [ -z "$selected_packages" ]; then
        log_warning "Пакеты не выбраны. Выход."
        exit 0
    fi
    
    # Преобразуем в массив
    local selected=()
    while IFS= read -r line; do
        selected+=("$line")
    done <<< "$selected_packages"
    
    echo ""
    log_info "Выбрано пакетов: ${#selected[@]}"
    
    # Анализируем каждый пакет
    local packages_with_conflicts=()
    local packages_clean=()
    
    for package in "${selected[@]}"; do
        preview_changes "$package"
        
        local conflicts=()
        while IFS= read -r line; do
            [ -n "$line" ] && conflicts+=("$line")
        done < <(check_conflicts "$package")
        
        if [ ${#conflicts[@]} -gt 0 ]; then
            packages_with_conflicts+=("$package")
        else
            packages_clean+=("$package")
        fi
    done
    
    # Обработка пакетов с конфликтами
    if [ ${#packages_with_conflicts[@]} -gt 0 ]; then
        echo ""
        log_warning "Обнаружены конфликты в пакетах: ${packages_with_conflicts[*]}"
        
        if gum confirm "Создать бэкапы существующих файлов?"; then
            mkdir -p "$BACKUP_DIR"
            
            for package in "${packages_with_conflicts[@]}"; do
                if ! create_backup "$package"; then
                    log_error "Не удалось создать бэкап для $package"
                    exit 1
                fi
            done
        else
            log_warning "Установка отменена"
            exit 0
        fi
    fi
    
    # Финальное подтверждение
    echo ""
    if ! gum confirm "Начать установку выбранных пакетов?"; then
        log_warning "Установка отменена"
        exit 0
    fi
    
    # Установка пакетов
    echo ""
    local success_count=0
    local fail_count=0
    
    for package in "${selected[@]}"; do
        if install_package "$package"; then
            ((success_count++))
        else
            ((fail_count++))
        fi
    done
    
    # Итоги
    echo ""
    echo "═══════════════════════════════════════════════"
    log_success "Успешно установлено: $success_count"
    [ $fail_count -gt 0 ] && log_error "Ошибок: $fail_count"
    echo "═══════════════════════════════════════════════"
    echo ""
}

# Запуск
main "$@"
