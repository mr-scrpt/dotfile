#!/bin/bash

# Конфигурация
DOTFILES_DIR="$HOME/Hellkitchen/dotfile"
TARGET_DIR="$HOME"
BACKUP_DIR="$DOTFILES_DIR/_backup"

# Исключения
EXCLUDED_DIRS=("_backup" ".git" ".stow-merge" ".stow-clean")

# Защищенные системные пути (никогда не превращать в симлинк-папку)
PROTECTED_DIRS=(".config" ".local" ".local/share" ".local/bin" ".var")

# Цвета
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

log_info() { echo -e "${BLUE}ℹ${NC} $1"; }
log_success() { echo -e "${GREEN}✓${NC} $1"; }
log_warning() { echo -e "${YELLOW}⚠${NC} $1"; }
log_error() { echo -e "${RED}✗${NC} $1"; }

check_dependencies() {
    local missing_deps=()
    if ! command -v stow &> /dev/null; then missing_deps+=("stow"); fi
    if ! command -v gum &> /dev/null; then missing_deps+=("gum"); fi
    [ ${#missing_deps[@]} -ne 0 ] && { log_error "Нет: ${missing_deps[*]}"; exit 1; }
}

check_dotfiles_dir() {
    [ ! -d "$DOTFILES_DIR" ] && { log_error "Нет папки $DOTFILES_DIR"; exit 1; }
}

get_available_packages() {
    local packages=()
    for dir in "$DOTFILES_DIR"/*/; do
        [ -d "$dir" ] || continue
        local package=$(basename "$dir")
        local skip=false
        for excluded in "${EXCLUDED_DIRS[@]}"; do
            [ "$package" = "$excluded" ] && { skip=true; break; }
        done
        [ "$skip" = false ] && packages+=("$package")
    done
    echo "${packages[@]}"
}

get_package_policy() {
    local package="$1"
    # Если есть файл .stow-merge - режим умного слияния
    if [ -f "$DOTFILES_DIR/$package/.stow-merge" ]; then echo "merge"; else echo "clean"; fi
}

is_protected_dir() {
    local dir="$1"
    for protected in "${PROTECTED_DIRS[@]}"; do
        [[ "$dir" == "$protected" || "$dir" == "$protected/" ]] && return 0
    done
    return 1
}

# Функция проверяет, есть ли в target-папке файлы, которых НЕТ в source-папке.
# Если есть -> папку нельзя удалять (return 0 / true)
# Если все файлы дублируются или папка пуста -> можно удалять (return 1 / false)
has_alien_files() {
    local target_dir="$1"
    local source_dir="$2"
    
    # Перебираем все файлы в целевой папке
    for item in "$target_dir"/*; do
        [ -e "$item" ] || continue # пустая папка
        local name=$(basename "$item")
        
        # Если такого имени нет в источнике -> это Чужой файл
        if [ ! -e "$source_dir/$name" ]; then
            return 0 # Found alien
        fi
    done
    return 1 # No aliens
}

check_conflicts() {
    local package="$1"
    local package_dir="$DOTFILES_DIR/$package"
    local policy=$(get_package_policy "$package")
    local conflicts=()
    local flagged_dirs=()

    local temp_source_list=$(mktemp)
    find "$package_dir" -mindepth 1 | sed "s|^$package_dir/||" > "$temp_source_list"

    while IFS= read -r rel_path; do
        [[ "$rel_path" == ".stow-merge" ]] && continue
        
        local source_path="$package_dir/$rel_path"
        local target_path="$TARGET_DIR/$rel_path"
        
        # Если родитель уже помечен на удаление/бэкап, пропускаем детей
        local parent_is_flagged=false
        for flagged in "${flagged_dirs[@]}"; do
            if [[ "$rel_path" == "$flagged/"* ]]; then parent_is_flagged=true; break; fi
        done
        [ "$parent_is_flagged" = true ] && continue

        # Если цели нет - не конфликт
        if [ ! -e "$target_path" ] && [ ! -L "$target_path" ]; then continue; fi

        # Если это правильный симлинк - не конфликт
        if [ -L "$target_path" ]; then
            local link_target=$(readlink -f "$target_path")
            local real_source=$(readlink -f "$source_path")
            [ "$link_target" == "$real_source" ] && continue
        fi

        # --- ЛОГИКА ---
        
        # ПАПКА против ПАПКИ
        if [ -d "$target_path" ] && [ -d "$source_path" ]; then
            if is_protected_dir "$rel_path"; then continue; fi

            if [ "$policy" == "clean" ]; then
                # Clean: всегда сносим папку (если не protected)
                conflicts+=("$target_path")
                flagged_dirs+=("$rel_path")
            else
                # Merge: Умная проверка
                if has_alien_files "$target_path" "$source_path"; then
                    # Найдены файлы, которых нет у нас (например hyprland.conf)
                    # ОСТАВЛЯЕМ папку (stow зайдет внутрь)
                    continue 
                else
                    # Папка содержит только то, что есть у нас (или пуста).
                    # Считаем это конфликтом -> Бэкапим папку -> Stow сделает симлинк на папку
                    conflicts+=("$target_path")
                    flagged_dirs+=("$rel_path")
                fi
            fi
            continue
        fi
        
        # ФАЙЛ против чего угодно - конфликт
        if [ -e "$target_path" ]; then conflicts+=("$target_path"); fi

    done < "$temp_source_list"
    rm "$temp_source_list"
    
    printf '%s\n' "${conflicts[@]}" | sort -u
}

create_backup() {
    local package="$1"
    local timestamp=$(date +"%d_%m_%y_%H_%M_%S")
    local backup_path="$BACKUP_DIR/${package}_${timestamp}"
    
    mapfile -t conflicts < <(check_conflicts "$package")
    [ ${#conflicts[@]} -eq 0 ] && return 0
    
    log_info "Бэкап для $package..."
    for conflict in "${conflicts[@]}"; do
        local rel_path="${conflict#$TARGET_DIR/}"
        local backup_file="$backup_path/$rel_path"
        mkdir -p "$(dirname "$backup_file")"
        mv "$conflict" "$backup_file" 2>/dev/null && log_success "  Backup: $rel_path" || { log_error "Fail: $rel_path"; return 1; }
    done
    return 0
}

install_package() {
    local package="$1"
    local out=$(stow -v -d "$DOTFILES_DIR" -t "$TARGET_DIR" "$package" 2>&1)
    if [ $? -eq 0 ]; then log_success "$package OK"; else log_error "$package Fail"; echo "$out" | sed 's/^/  /'; return 1; fi
}

preview_changes() {
    local package="$1"
    local policy=$(get_package_policy "$package")
    local col=$([ "$policy" == "clean" ] && echo "$RED" || echo "$BLUE")
    
    echo -e "\n📦 Пакет: ${col}${package}${NC} [${policy^^}]"
    local conflicts=$(check_conflicts "$package")
    
    if [ -n "$conflicts" ]; then
        echo "$conflicts" | while read -r t; do echo -e "${YELLOW}[REPLACE]${NC} ${t#$TARGET_DIR/}"; done
        return 1
    else
        echo -e "${GREEN}[OK]${NC} Чисто."
        return 0
    fi
}

main() {
    echo -e "\n🔧 Dotfiles Manager v4 (Smart Merge)"
    check_dependencies; check_dotfiles_dir
    
    local pkgs=($(get_available_packages))
    [ ${#pkgs[@]} -eq 0 ] && exit 1
    
    local sel=$(printf '%s\n' "${pkgs[@]}" | gum choose --no-limit --header "Select packages:")
    [ -z "$sel" ] && exit 0
    
    local conflicts=()
    for p in $sel; do preview_changes "$p" || conflicts+=("$p"); done
    
    if [ ${#conflicts[@]} -gt 0 ]; then
        gum confirm "Разрешить конфликты (backup & replace)?" || exit 0
        mkdir -p "$BACKUP_DIR"
        for p in "${conflicts[@]}"; do create_backup "$p" || exit 1; done
    fi
    
    gum confirm "Установить?" || exit 0
    for p in $sel; do install_package "$p"; done
}

main "$@"
