#!/usr/bin/env bun
import { launchSession, type SessionBlueprint } from "./session-launcher";

// 1. Парсинг аргументов
const sessionName = process.argv[2];
if (!sessionName) {
  console.error("Usage: tdev <session-name>");
  process.exit(1);
}

// 2. Декларативное описание среды разработки
const devBlueprint: SessionBlueprint = {
  sessionName,
  windows: [
    {
      name: " editor",
      cmd: "nvim",
      fallbackCmd: 'echo "Warning: nvim not found"',
      focus: true,
    },
    { name: " server" },
    { name: " infra" },
    { name: " terminal" },
    {
      name: " docker",
      cmd: "lazydocker",
      fallbackCmd: 'echo "Warning: lazydocker not found"',
    },
    {
      name: " file-manager",
      cmd: "yazi",
      fallbackCmd: "yy", // Используется твой bash-wrapper, если yazi не установлен
    },
  ],
};

// 3. Запуск движка
await launchSession(devBlueprint);
