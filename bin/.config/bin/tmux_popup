#!/bin/bash

unset TMUX

TARGET_NAME="$1"
START_DIR="$2"
GLOBAL_SESSION="_global_popups"
MEM_KEY="@popup_mem_${TARGET_NAME}"

if [ -z "$TARGET_NAME" ]; then TARGET_NAME="default"; fi
if [ -z "$START_DIR" ]; then START_DIR="$HOME"; fi

# ==============================================================================
# ЧАСТЬ 1: ПОИСК СОКЕТА (SOCKET HUNTER + TIME SORT)
# ==============================================================================

# 1. Сначала пробуем стандартные методы (на случай, если они работают)
WD=$(tmux display-message -p "#{client_env:WAYLAND_DISPLAY}")
if [ -z "$WD" ]; then WD="$WAYLAND_DISPLAY"; fi

# 2. ЕСЛИ ПУСТО (после перезагрузки): Ищем самый свежий файл на диске
if [ -z "$WD" ]; then
  USER_ID=$(id -u)
  RUNTIME_DIR="/run/user/$USER_ID"

  # IMPROVEMENT:
  # Вместо find (который берет любой), используем ls -t (сортировка по времени).
  # head -n 1 берет самый верхний (самый новый).
  # Это защищает от старых "зомби-сокетов", оставшихся после сбоев.
  FOUND_SOCKET=$(ls -t "$RUNTIME_DIR"/wayland-* 2>/dev/null | head -n 1)

  if [ -n "$FOUND_SOCKET" ]; then
    # Отрезаем путь, оставляем только имя (например, wayland-1)
    WD=$(basename "$FOUND_SOCKET")
  fi
fi

# 3. АВАРИЙНЫЙ ВАРИАНТ (Если вообще ничего не нашли, ставим дефолт)
if [ -z "$WD" ]; then WD="wayland-1"; fi

# ==============================================================================
# ЧАСТЬ 2: ЖЕСТКОЕ ОБНОВЛЕНИЕ ОКРУЖЕНИЯ
# ==============================================================================

# Мы нашли сокет физически. Теперь ТЫКАЕМ его в Tmux.
# Обновляем глобально (-g), чтобы wl-copy (запускаемый сервером) увидел его.
tmux set-environment -g WAYLAND_DISPLAY "$WD"

# ==============================================================================
# ЧАСТЬ 3: ПОДГОТОВКА СЕССИИ
# ==============================================================================

if ! tmux has-session -t "$GLOBAL_SESSION" 2>/dev/null; then
  tmux new-session -d -s "$GLOBAL_SESSION" -c "$START_DIR" -n "$TARGET_NAME" -e "WAYLAND_DISPLAY=$WD"
  tmux set-option -t "$GLOBAL_SESSION" detach-on-destroy off
  tmux set-option -t "$GLOBAL_SESSION" status on
else
  # Если сессия есть — обновляем переменную ВНУТРИ неё
  tmux set-environment -t "$GLOBAL_SESSION" WAYLAND_DISPLAY "$WD"

  if ! tmux list-windows -t "$GLOBAL_SESSION" -F "#{window_name}" | grep -q "^${TARGET_NAME}$"; then
    tmux new-window -t "$GLOBAL_SESSION" -n "$TARGET_NAME" -c "$START_DIR"
  fi
fi

# ==============================================================================
# ЧАСТЬ 4: ЛОГИКА ПАМЯТИ
# ==============================================================================

LAST_WIN=$(tmux show-option -gqv "$MEM_KEY")

if [[ -n "$LAST_WIN" ]] && tmux list-windows -t "$GLOBAL_SESSION" -F "#{window_name}" | grep -q "^${LAST_WIN}$"; then
  OPEN_WIN="$LAST_WIN"
else
  OPEN_WIN="$TARGET_NAME"
fi

# ==============================================================================
# ЧАСТЬ 5: ЗАПУСК
# ==============================================================================

SHADOW_SESSION="popup_shadow_$$"
tmux new-session -d -t "$GLOBAL_SESSION" -s "$SHADOW_SESSION"

# Обновляем ENV тени
tmux set-environment -t "$SHADOW_SESSION" WAYLAND_DISPLAY "$WD"

tmux set-option -t "$SHADOW_SESSION" status off
tmux set-option -t "$SHADOW_SESSION" detach-on-destroy off

tmux select-window -t "$SHADOW_SESSION:${OPEN_WIN}"

trap "tmux kill-session -t '$SHADOW_SESSION' 2>/dev/null" EXIT INT TERM

# ЗАПУСК И ОЖИДАНИЕ (Скрипт висит тут пока ты работаешь)
tmux attach-session -t "$SHADOW_SESSION"

# ==============================================================================
# ЧАСТЬ 6: СОХРАНЕНИЕ
# ==============================================================================

FINAL_WIN=$(tmux display-message -t "$SHADOW_SESSION" -p "#{window_name}" 2>/dev/null)

if [ -n "$FINAL_WIN" ]; then
  tmux set-option -g "$MEM_KEY" "$FINAL_WIN"
fi

