#!/bin/bash

unset TMUX

TARGET_NAME="$1"
START_DIR="$2"
GLOBAL_SESSION="_global_popups"

if [ -z "$TARGET_NAME" ]; then TARGET_NAME="default"; fi
if [ -z "$START_DIR" ]; then START_DIR="$HOME"; fi

# --- FIX: ПОЛУЧЕНИЕ АКТУАЛЬНОГО WAYLAND_DISPLAY ---
# 1. Спрашиваем у текущего клиента (того, где ты нажал Ctrl+g), какой у него дисплей.
# #{client_env:VAR} — это самый надежный способ получить свежую переменную.
WD=$(tmux display-message -p "#{client_env:WAYLAND_DISPLAY}")

# Если вдруг не получилось (пусто), берем из текущего окружения скрипта
if [ -z "$WD" ]; then
  WD="$WAYLAND_DISPLAY"
fi

# 2. ПРИНУДИТЕЛЬНО ОБНОВЛЯЕМ ГЛОБАЛЬНОЕ ОКРУЖЕНИЕ TMUX
# Это нужно, чтобы команда 'copy-pipe' (wl-copy), которую запускает сервер, видела новый сокет.
tmux set-environment -g WAYLAND_DISPLAY "$WD"

# --- КОНЕЦ FIX ---

if ! tmux has-session -t "$GLOBAL_SESSION" 2>/dev/null; then
  # Создаем сессию с правильной переменной
  tmux new-session -d -s "$GLOBAL_SESSION" -c "$START_DIR" -n "$TARGET_NAME" -e "WAYLAND_DISPLAY=$WD"

  tmux set-option -t "$GLOBAL_SESSION" detach-on-destroy off
  tmux set-option -t "$GLOBAL_SESSION" status on
else
  # Если сессия уже жива (восстановлена), ОБНОВЛЯЕМ В НЕЙ ПЕРЕМЕННУЮ
  tmux set-environment -t "$GLOBAL_SESSION" WAYLAND_DISPLAY "$WD"

  if ! tmux list-windows -t "$GLOBAL_SESSION" -F "#{window_name}" | grep -q "^${TARGET_NAME}$"; then
    tmux new-window -t "$GLOBAL_SESSION" -n "$TARGET_NAME" -c "$START_DIR"
  fi
fi

SHADOW_SESSION="popup_shadow_$$"

# Теневая сессия подхватит обновленное окружение
tmux new-session -d -t "$GLOBAL_SESSION" -s "$SHADOW_SESSION"

tmux set-option -t "$SHADOW_SESSION" status off
tmux set-option -t "$SHADOW_SESSION" detach-on-destroy on

tmux select-window -t "$SHADOW_SESSION:${TARGET_NAME}"

trap "tmux kill-session -t '$SHADOW_SESSION' 2>/dev/null" EXIT

tmux attach-session -t "$SHADOW_SESSION"
