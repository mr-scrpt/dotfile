#!/bin/bash

# --- Главное меню ---
ACTION_GENERATE="󰐾 Generate & Copy Password"
ACTION_SEARCH=" Search Stored Password"
MENU_OPTIONS="$ACTION_GENERATE\n$ACTION_SEARCH"

SELECTED_ACTION=$(echo -e "$MENU_OPTIONS" | walker --dmenu --theme dmenu_250 -p "󰌋 Password Menu:")

# --- Обработка выбора ---
case "$SELECTED_ACTION" in
"$ACTION_GENERATE")
  # Если пользователь выбрал "Generate & Copy Password"

  # 1. Генерируем надежный 20-символьный пароль.
  #    Используем /dev/urandom для криптографической случайности.
  #    tr -dc '...' оставляет только нужные символы: буквы, цифры и спецсимволы.
  new_password=$(tr -dc 'A-Za-z0-9!"#$%&'\''()*+,-./:;<=>?@[\]^_`{|}~' </dev/urandom | head -c 20)

  # 2. Копируем пароль в буфер обмена Wayland.
  #    Флаг -n у echo убирает перенос строки в конце.
  echo -n "$new_password" | wl-copy

  # 3. Показываем уведомление об успехе.
  notify-send "🔐 Password Generated" "A new random password has been copied to your clipboard."
  ;;

"$ACTION_SEARCH")
  # Эта часть будет реализована на следующем шаге.
  notify-send "Work in Progress" "Search functionality will be added next."
  ;;
esac
