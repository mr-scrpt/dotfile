#!/bin/bash

# Указываем путь к лог-файлу
LOG_FILE="/tmp/pass_walker_debug.log"

# Очищаем старый лог
echo "--- Starting new debug session at $(date) ---" >"$LOG_FILE"

# 1. Записываем изначальное окружение
echo "### 1. Initial Environment ###" >>"$LOG_FILE"
env | grep -E 'GPG|SSH' >>"$LOG_FILE"
echo "tty is: $(tty)" >>"$LOG_FILE"
echo "--------------------------" >>"$LOG_FILE"

# 2. Пытаемся подключиться к агенту и записываем результат
echo "" >>"$LOG_FILE"
echo "### 2. Running 'gpgconf --launch gpg-agent' ###" >>"$LOG_FILE"
GPG_ENV_VARS=$(gpgconf --launch gpg-agent)
echo "Output of gpgconf: $GPG_ENV_VARS" >>"$LOG_FILE"
export $GPG_ENV_VARS
echo "--------------------------" >>"$LOG_FILE"

# 3. Записываем окружение ПОСЛЕ нашей попытки его исправить
echo "" >>"$LOG_FILE"
echo "### 3. Environment after attempting to fix ###" >>"$LOG_FILE"
env | grep -E 'GPG|SSH' >>"$LOG_FILE"
echo "--------------------------" >>"$LOG_FILE"

# 4. Вызываем pass с максимальной отладкой и записываем ВСЁ
echo "" >>"$LOG_FILE"
echo "### 4. Calling pass with full debug ###" >>"$LOG_FILE"
GPG_OPTS="--debug-all --verbose" pass show ai/gemini_cli_mom >/dev/null 2>>"$LOG_FILE"

echo "" >>"$LOG_FILE"
echo "--- Debug session finished ---" >>"$LOG_FILE"

# Показываем уведомление, что тест завершен
notify-send "Debug Finished" "Log file created at /tmp/pass_walker_debug.log"
