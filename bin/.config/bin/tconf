#!/bin/sh
create_session() {
  local session_name="config"
  # Проверяем, существует ли сессия
  tmux has-session -t "$session_name" 2>/dev/null
  if [ $? -eq 0 ]; then
    echo "Session $session_name already exists"
    return
  fi
  # Создаем новую сессию
  tmux new -s "$session_name" -d
    # Определяем конфигурации для окон: [имя окна]:[путь]
  # Номера окон будут браться из индекса массива + 1
windows=(
    "  nvim:nvim"
    "  hypr:hypr"
    "  waybar:waybar"
    " 󰒋 tmux:tmux"
    "  kitty:kitty"
    "  fish:fish"
    "  yazi:yazi"
    " 󰨭 rofi:rofi"
    "  bin:bin"
    "  startup:startup"
    " 󰝡 other:other"
  )  
  # Создаем окна через цикл
  for i in "${!windows[@]}"; do
    window_number=$((i + 1))
    window_config="${windows[$i]}"
    
    # Разбиваем строку на имя и путь
    name=$(echo "$window_config" | cut -d ':' -f 1)
    path=$(echo "$window_config" | cut -d ':' -f 2)
    
    # Для первого окна не нужно создавать новое, только переименовать
    if [ "$window_number" = "1" ]; then
      tmux rename-window -t "$session_name:1" "$name"
    else
      # Создаем новое окно с явным указанием номера
      tmux new-window -t "$session_name:$window_number" -n "$name"
    fi
    
    echo "-----"
    echo "cd ~/Hellkitchen/dotfile/$path/.config/$path" 
    echo "$session_name:$window_number"
    echo "-----"
    
    # Небольшая задержка перед отправкой команд
    sleep 0.1
    
    # Отправляем команды
    tmux send-keys -t "$session_name:$window_number" "cd ~/Hellkitchen/dotfile/$path/.config/$path" Enter
    tmux send-keys -t "$session_name:$window_number" "clear" Enter
  done 
  
  # Небольшая задержка перед выбором окна
  sleep 0.1
  tmux select-window -t "$session_name:1"
}

# Основная логика скрипта
if [ -n "$TMUX" ]; then
  # Если мы в tmux
  create_session
  tmux switch-client -t "config"
else
  # Если мы не в tmux
  create_session
  tmux attach-session -t "config"
fi
