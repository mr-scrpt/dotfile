#!/bin/bash

# Turn the big monitor (DP-1, AORUS FO48U) on or off.
# State lives in XDG_RUNTIME_DIR, so it resets to "off" on every reboot.
# ~/.config/hypr/monitors.lua reads the same flag on every Hyprland reload.

OUTPUT="DP-1"
FLAG="${XDG_RUNTIME_DIR:-/tmp}/omarchy-big-monitor-enabled"

is_on() { [[ -e $FLAG ]]; }

apply() {
  hyprctl reload >/dev/null
}

wake() {
  hyprctl dispatch 'hl.dsp.dpms({ action = "enable" })' >/dev/null 2>&1 || true
}

on() {
  touch "$FLAG"
  apply
  wake
  omarchy-notification-send -g 󰍹 "Big monitor enabled" "$OUTPUT"
}

off() {
  rm -f "$FLAG"
  apply
  omarchy-notification-send -g 󰶐 "Big monitor disabled" "$OUTPUT"
}

status() {
  if is_on; then echo on; else echo off; exit 1; fi
}

case "$1" in
  on) on ;;
  off) off ;;
  toggle) if is_on; then off; else on; fi ;;
  status) status ;;
  *)
    echo "Usage: $(basename "$0") {on|off|toggle|status}" >&2
    exit 1
    ;;
esac
