// Bar UI elements: omarchy launcher and separators
{
  "custom/omarchy": {
    "format": "<span font='omarchy'>\ue900</span>",
    "on-click": "omarchy-menu",
    "on-click-right": "xdg-terminal-exec",
    "tooltip-format": "Omarchy Menu\n\nSuper + Alt + Space"
  },
  "custom/separator": {
    "format": " |",
    "tooltip": false
  },
  "custom/separatorEqual": {
    "format": "|",
    "tooltip": false
  }
}