# Игнорируем все плагины tmux
tmux/.config/tmux/plugins/*

# Но оставляем tpm
!tmux/.config/tmux/plugins/tpm/
!tmux/.config/tmux/plugins/tpm/**

# Приватные файлы
fish/.config/fish/private.env
nvim/.config/nvim/mcpservers.json
mcpservers.json

# Rust build artifacts
lianli/sensor-service/target/

# Runtime state files (transient, not config)
lianli/.config/lianli/current_rgb_profile

# Local backup snapshots (kept in working tree for quick rollback, not committed)
lianli/.config/lianli/*.bak-*
lianli/sensor-service/src/*.bak-*
