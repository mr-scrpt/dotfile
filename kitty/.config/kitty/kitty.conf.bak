# Font

font_family      JetBrainsMono Nerd Font
bold_font        JetBrainsMono NF Bold
italic_font      JetBrainsMono NF Italic
bold_italic_font JetBrainsMono NF Medium Italic
font_size 10
modify_font cell_height 122%

# Theme
# is allredy install, need apllay, read doc
# include themes/catppuccin-macchiato.conf
# include themes/catppuccin-mocha.conf

# Window layout
enabled_layouts *
window_resize_step_cells 2
window_resize_step_lines 2
window_border_width 1pt
window_margin_width 0
single_window_margin_width -1
window_padding_width 4

# Tab bar
tab_bar_edge bottom
tab_bar_margin_width 0.0
tab_bar_margin_height 0.0 0.0
tab_bar_style powerline
tab_bar_align left
tab_bar_min_tabs 2
tab_switch_strategy previous
tab_fade 0.25 0.5 0.75 1
tab_separator " ┇"
tab_powerline_style slanted
tab_activity_symbol none
tab_title_template "{f'{title[:30]}…' if title.rindex(title[-1]) + 1 > 30 else (title.center(6) if (title.rindex(title[-1]) + 1) % 2 == 0 else title.center(5))}"
active_tab_title_template none
active_tab_font_style   bold-italic
inactive_tab_font_style normal

# Background
# background_opacity 0.96

# Other
shell fish
editor nvim
allow_remote_control yes
listen_on unix:@mykitty
allow_hyperlinks yes
shell_integration enabled
confirm_os_window_close 0
cursor_trail 1
cursor_trail_decay 0.1 0.2
cursor_trail_start_threshold 4


# Keybindings
kitty_mod ctrl+shift

# Scrolling
map kitty_mod+up    scroll_line_up
map opt+cmd+page_up scroll_line_up
map cmd+up          scroll_line_up

map kitty_mod+down    scroll_line_down
map opt+cmd+page_down scroll_line_down
map cmd+down          scroll_line_down


map kitty_mod+f5 load_config_file

# kitty-scrollback.nvim Kitten alias
action_alias kitty_scrollback_nvim kitten ~/.local/share/nvim/lazy/kitty-scrollback.nvim/python/kitty_scrollback_nvim.py

# Browse scrollback buffer in nvim
map kitty_mod+h kitty_scrollback_nvim
# Browse output of the last shell command in nvim
# map kitty_mod+g kitty_scrollback_nvim --config ksb_builtin_last_cmd_output
# Show clicked command output in nvim
# mouse_map ctrl+shift+right press ungrabbed combine : mouse_select_command_output : kitty_scrollback_nvim --config ksb_builtin_last_visited_cmd_output

map ctrl+alt+t send_text all \x0ec
map ctrl+alt+i send_text all \x0eI
map ctrl+alt+d send_text all \x0ed
map ctrl+alt+s send_text all \x0eL
map ctrl+alt+l send_text all \x0ew
map ctrl+alt+r send_text all \x0e,
map ctrl+alt+k send_text all \x0en
map ctrl+alt+j send_text all \x0ep
map ctrl+alt+o send_text all \x0eO
map ctrl+alt+shift+k send_text all \x0e>
map ctrl+alt+shift+j send_text all \x0e
map ctrl+alt+v send_text all \x0e%
map ctrl+alt+1 send_text all \x0e1
map ctrl+alt+h send_text all \x0e"
map ctrl+alt+2 send_text all \x0e2
map ctrl+alt+3 send_text all \x0e3
map ctrl+alt+4 send_text all \x0e4
map ctrl+alt+5 send_text all \x0e5
map ctrl+alt+6 send_text all \x0e6
map ctrl+alt+7 send_text all \x0e7
map ctrl+alt+8 send_text all \x0e8
map ctrl+alt+9 send_text all \x0e9
#TMUX YANK
map ctrl+alt+y send_text all \x0ey

map ctrl+alt+c send_text all \x0e[




# BEGIN_KITTY_THEME
# Catppuccin-Macchiato
include current-theme.conf
# END_KITTY_THEME
