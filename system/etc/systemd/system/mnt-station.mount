[Unit]
Description=Station NAS (TrueNAS mediastation via SMB)
After=network-online.target
Wants=network-online.target

[Mount]
What=//192.168.1.100/mediastation
Where=/mnt/station
Type=cifs
Options=credentials=/home/mr/.local/share/secrets/truenas.cred,uid=1000,gid=1000,iocharset=utf8,file_mode=0664,dir_mode=0775,vers=3.1.1,nofail,_netdev,soft
TimeoutSec=30

[Install]
WantedBy=multi-user.target
