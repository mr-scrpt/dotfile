          "kind": {
            "type": "radial_gauge",
            "source": {
              "type": "command",
              "cmd": "R1=$(cat /sys/class/net/wlan0/statistics/rx_bytes); T1=$(cat /sys/class/net/wlan0/statistics/tx_bytes); sleep 1; R2=$(cat /sys/class/net/wlan0/statistics/rx_bytes); T2=$(cat /sys/class/net/wlan0/statistics/tx_bytes); echo $(( (R2 - R1 + T2 - T1) / 1024 ))"
            },
            "value_min": 0.0,
            "value_max": 10240.0,
            "start_angle": 270,
            "sweep_angle": 360,
            "inner_radius_pct": 0.7,
