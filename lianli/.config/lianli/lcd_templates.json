            "font": { "path": null },
            "font_size": 44,
            "color": [205, 214, 244, 255],
            "align": "center"
          }
        },
        {
          "id": "gauge-temp",
          "x": 200,
          "y": 200,
          "width": 410,
          "height": 410,
          "rotation": 0.0,
          "visible": true,
          "update_interval_ms": 1000,
          "fps": null,
          "kind": {
            "type": "radial_gauge",
