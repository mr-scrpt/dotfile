[Unit]
Description=OpenRGB server (SMBus DRAM + HID motherboard/Strimer)
# Start only after lianli-daemon has finished USB enumeration, otherwise the
# two race each other during libusb open() and the 8.8" LED Ring ends up in a
# partial frame state (yellow-blue gradient instead of solid cyan).
After=graphical-session.target lianli-daemon.service
Requires=lianli-daemon.service
PartOf=graphical-session.target

[Service]
Type=simple
# Give lianli-daemon a few seconds to settle USB enumeration before OpenRGB
# starts probing HID/I2C. This avoids races on shared USB controllers.
ExecStartPre=/bin/sleep 3
ExecStart=/usr/bin/openrgb --server
# The server runs in the foreground; exit=0 means user-initiated stop.
Restart=on-failure
RestartSec=5

[Install]
WantedBy=graphical-session.target
