// Claude Code usage limits: 5-hour and weekly window (same data as /usage in the CLI)
{
    "custom/claude": {
        "format": "{}",
        "return-type": "json",
        "exec": "~/.config/waybar/scripts/claude-usage.sh",
        // Эндпоинт с общим rate limit'ом (429) на аккаунт — чаще не стоит
        "interval": 120,
        "signal": 9,
        // Клик — попап с деталями (уведомление), правый клик — форс-обновление
        "on-click": "~/.config/waybar/scripts/claude-usage.sh --popup",
        "on-click-right": "pkill -RTMIN+9 waybar",
        "tooltip": true
    }
}
