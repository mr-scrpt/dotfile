// Переключаемый виджет лимитов: Codex по умолчанию, Claude — средним кликом.
// Оригинальные modules/claude.jsonc и scripts/claude-usage.sh сохранены.
{
    "custom/ai-usage": {
        "format": "{}",
        "return-type": "json",
        "exec": "~/.config/waybar/scripts/ai-usage.sh",
        // UI обновляется каждую минуту, но Codex API — не чаще раза в 5 минут.
        "interval": 60,
        "signal": 9,
        "on-click": "~/.config/waybar/scripts/ai-usage.sh --popup",
        "on-click-middle": "~/.config/waybar/scripts/ai-usage.sh --toggle",
        "on-click-right": "~/.config/waybar/scripts/ai-usage.sh --refresh",
        "tooltip": true
    }
}
