// Secondary bar configuration for DP-1 monitor (bottom position)
{
  "include": [
    "modules/workspace.jsonc",
    "modules/bars.jsonc",
    "modules/system.jsonc",
    "modules/time.jsonc",
    "modules/custom.jsonc"
  ],
  "name": "dp_1",
  "reload_style_on_change": true,
  "layer": "top",
  "position": "top",
  "spacing": 0,
  "height": 26,
  "modules-left": [
    "custom/omarchy",
    "hyprland/workspaces#secondary"
  ],
  "modules-center": [
    "hyprland/language",
    "custom/separator",
    "clock#time",
    "custom/separator",
    "clock#date",
    "custom/update",
    "custom/screenrecording-indicator"
  ],
  "modules-right": [
    "tray",
    "custom/separatorEqual",
    "bluetooth",
    "network",
    "pulseaudio",
    "cpu"
  ]
}