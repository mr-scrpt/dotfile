// Primary bar configuration for HDMI-A-1 monitor
{
  "include": [
    "~/.config/waybar/modules/workspace.jsonc",
    "~/.config/waybar/modules/bars.jsonc",
    "~/.config/waybar/modules/system.jsonc",
    "~/.config/waybar/modules/time.jsonc",
    "~/.config/waybar/modules/custom.jsonc"
  ],
  "name": "hdmi_1",
  "reload_style_on_change": true,
  "layer": "top",
  "position": "top",
  "spacing": 0,
  "height": 26,
  "modules-left": [
    "custom/omarchy",
    "hyprland/workspaces#primary"
  ],
  "modules-center": [
    "hyprland/language",
    "custom/separator",
    "clock#time",
    "custom/separator",
    "clock#date",
    "custom/update",
    "custom/screenrecording-indicator",
    "custom/separator",
    "custom/tor",

  ],
  "modules-right": [
    "tray",
    "custom/separatorEqual",
    "bluetooth",
    "network",
    "pulseaudio",
    "cpu"
  ]
}
