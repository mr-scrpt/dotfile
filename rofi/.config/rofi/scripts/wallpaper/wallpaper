#!/bin/bash

wallpapers_dir="$HOME/.config/hypr/theme/walls/"

# Функция для создания темы rofi
build_theme() {
  rows=$1
  cols=$2
  icon_size=$3
  echo "element{orientation:vertical;}element-text{horizontal-align:0.5;}element-icon{size:$icon_size.0000em;}listview{lines:$rows;columns:$cols;}"
}

# Получаем активный монитор (где находится курсор мыши)
get_active_monitor() {
  hyprctl cursorpos | awk '{
    # Парсим позицию курсора
    gsub(/[(),]/, " ")
    cursor_x = $1
    cursor_y = $2
  }
  END {
    # Получаем информацию о мониторах и находим активный
    cmd = "hyprctl monitors -j"
    cmd | getline monitors_json
    close(cmd)
    
    # Упрощенный парсинг JSON для получения имени монитора
    # В реальности лучше использовать jq, но для простоты делаем так
    if (cursor_x < 1920) {
      print "HDMI-A-2"  # Предполагаем, что левый монитор
    } else {
      print "DP-2"       # Предполагаем, что правый монитор
    }
  }'
}

# Более надежный способ определения активного монитора
get_active_monitor_reliable() {
  # Простой и надежный способ - используем активный воркспейс
  if command -v jq >/dev/null 2>&1; then
    hyprctl activeworkspace -j | jq -r '.monitor'
  else
    # Fallback без jq - парсим вывод активного воркспейса
    hyprctl activeworkspace | grep "on monitor" | awk '{print $NF}'
  fi
}

# Определяем активный монитор
active_monitor=$(get_active_monitor_reliable)

# Отладочная информация
echo "Active monitor detected: '$active_monitor'" >&2
echo "Available monitors:" >&2
hyprctl monitors | grep "Monitor" >&2

# Проверяем, что монитор определился корректно
if [ -z "$active_monitor" ]; then
  echo "Error: Could not determine active monitor!" >&2
  # Используем первый доступный монитор как fallback
  active_monitor=$(hyprctl monitors | grep "Monitor" | head -1 | awk '{print $2}')
  echo "Using fallback monitor: '$active_monitor'" >&2
fi

# Настройки rofi
theme="$HOME/.config/rofi/scripts/wallpaper/style.rasi"
rofi_cmd="rofi -dmenu -i -show-icons -theme-str $(build_theme 4 3 12) -theme ${theme}"

# Показываем селектор обоев
choice=$(
  ls --escape "$wallpapers_dir" |
    while read A; do echo -en "$A\x00icon\x1f$wallpapers_dir/$A\n"; done |
    $rofi_cmd
)

# Если ничего не выбрано, выходим
if [ -z "$choice" ]; then
  exit 1
fi

WALLPAPER="$wallpapers_dir/$choice"

# Устанавливаем обои только на активный монитор
if pgrep -x "hyprpaper" >/dev/null; then
  # Для hyprpaper нужно сначала загрузить обои, затем установить на конкретный монитор
  hyprctl hyprpaper preload "$WALLPAPER"
  hyprctl hyprpaper wallpaper "$active_monitor,$WALLPAPER" &&
    notify-send "Wallpaper Changed" "Monitor: $active_monitor" -i "$WALLPAPER" --app-name=Wallpaper
elif pgrep -x "swww-daemon" >/dev/null; then
  # Для swww устанавливаем обои на конкретный монитор
  swww img "$WALLPAPER" \
    --outputs "$active_monitor" \
    --transition-bezier 0.5,1.19,.8,.4 \
    --transition-type wipe \
    --transition-duration 2 \
    --transition-fps 75 &&
    notify-send "Wallpaper Changed" "Monitor: $active_monitor" -i "$WALLPAPER" --app-name=Wallpaper
fi
